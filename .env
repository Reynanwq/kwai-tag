# Versões das imagens e portas expostas no host.
# O docker compose lê este arquivo automaticamente e substitui ${VARIAVEL} no docker-compose.yml.

KAFKA_IMAGE=apache/kafka:3.8.0
KAFKA_UI_IMAGE=provectuslabs/kafka-ui:v0.7.2
MONGO_IMAGE=mongo:7.0
WIREMOCK_IMAGE=wiremock/wiremock:3.9.1

# Porta do Kafka para os apps rodando na IDE (fora do Docker): localhost:9092
KAFKA_HOST_PORT=9092
# 8080 já está ocupada nesta máquina (processo java)
KAFKA_UI_HOST_PORT=8090
# 27017 já está ocupada nesta máquina (container mongo-mongo-1)
MONGO_HOST_PORT=27019
WIREMOCK_HOST_PORT=8089

# Tópicos: número de partições na criação (não mudar depois de ter dados — ver KAFKA.md seção 4)
TOPIC_PARTITIONS=3
